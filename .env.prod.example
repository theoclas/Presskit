# Producción (VPS). Copiar a .env con scripts/init-env.sh, que genera los secretos.
# - chmod 600, nunca en git. Guarda una copia en tu gestor de contraseñas.
# - Valores con espacios, $ o comillas van entre comillas SIMPLES ('...'): compose interpreta $.
# - Claves de BD en hex: caben sin escapar en DATABASE_URL.
# - Ninguna variable ADMIN_* salvo ADMIN_NOTIFY_EMAIL: el admin se crea con la CLI interactiva.

# --- Compose ---
COMPOSE_PROJECT_NAME=fersua-booking
COMPOSE_FILE=docker-compose.prod.yml
# Puerto del edge, solo en 127.0.0.1. Debe coincidir con deploy/host-nginx/snippets/fersua-booking-proxy.conf
EDGE_PORT=8090

# --- URLs (en el cambio de dominio basta editar y reiniciar el api) ---
PUBLIC_URL=https://booking.fersuastudio.com
# Orígenes extra además de PUBLIC_URL, separados por coma. Normalmente vacío.
CORS_ORIGINS=
APP_TIMEZONE=America/Bogota

# --- MySQL (init-env.sh: openssl rand -hex 32) ---
DB_NAME=fersua_booking
DB_ROOT_PASSWORD=
# Usuario que migra (MYSQL_USER de la imagen): todos los permisos sobre DB_NAME.
DB_MIGRATOR_USER=fersua_migrator
DB_MIGRATOR_PASSWORD=
# Usuario del api: solo SELECT/INSERT/UPDATE/DELETE (deploy/mysql/init/01-app-user.sh).
DB_APP_USER=fersua_app
DB_APP_PASSWORD=
DB_CONNECTION_LIMIT=5

# --- Secretos de la app (init-env.sh: openssl rand -hex 48; MFA_ENC_KEY: -hex 32) ---
JWT_ACCESS_SECRET=
BOOKING_FORM_SECRET=
IP_HASH_SECRET=
# 32 bytes en hex (64 caracteres). Cifra el secreto TOTP del admin: si se pierde, hay que reconfigurar el 2FA.
MFA_ENC_KEY=

# --- Correo (Hostinger Email, buzón no-reply@fersuastudio.com) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@fersuastudio.com
# La clave del buzón, entre comillas simples.
SMTP_PASS=''
MAIL_FROM='Fersua Studio <no-reply@fersuastudio.com>'
# Recibe los avisos del admin: DJ en revisión, PQRS nuevas y alertas del vigilante (ops:alert).
# Vacío = el correo del admin.
ADMIN_NOTIFY_EMAIL=

# --- Banderas ---
# true cuando Fernando decida indexar booking. (docs/05-cambio-dns.md), junto con quitar el
# X-Robots-Tag del vhost. check-env.sh no lo deja con marcadores legales sin llenar.
SEO_INDEXABLE=false
# true cuando se abra el registro de DJs (M3).
REGISTRATION_OPEN=false
LOG_LEVEL=info

# --- Respaldos (scripts/backup.sh) ---
BACKUP_DIR=/home/deploy/backups/fersua-booking
# Días que se guardan los respaldos nocturnos de la BD (los semanales, 8 semanas). Máximo 21:
# la política de privacidad promete que un dato borrado sale de los respaldos en 8 semanas,
# contando la copia externa (docs/04-backups.md).
BACKUP_RETENTION_DAYS=14
# Instantáneas diarias de los medios que se guardan (incrementales con enlaces duros).
BACKUP_MEDIA_KEEP=7
# Opcional: URL de healthchecks.io que se llama al terminar cada respaldo nocturno.
BACKUP_HEALTHCHECK_URL=

# --- Copia externa cifrada (scripts/offsite-backup.sh; opcional, guía en docs/04-backups.md) ---
# Van comentadas a propósito: sin ellas la copia externa queda "no configurada" y check-env.sh
# no las exige. Para activarla, pega en .env las que uses, sin el "# " del inicio.
# Repositorio restic: rclone:<remoto>:<carpeta> (Google Drive, la opción elegida) o
# b2:<bucket>:<carpeta> (Backblaze B2).
# OFFSITE_RESTIC_REPOSITORY=rclone:gdrive:fersua-booking-respaldos
# Clave que cifra las copias (openssl rand -hex 32). Guárdala en tu gestor de contraseñas: sin
# ella las copias NO se pueden leer, ni siquiera tú.
# OFFSITE_RESTIC_PASSWORD=
# B2: la llave de aplicación limitada al bucket (keyID y applicationKey).
# OFFSITE_B2_ACCOUNT_ID=
# OFFSITE_B2_ACCOUNT_KEY=
# B2 por su API compatible con S3 (si b2: da errores), con OFFSITE_RESTIC_REPOSITORY=
# s3:https://s3.<región>.backblazeb2.com/<bucket>/<carpeta> y la misma llave:
# OFFSITE_AWS_ACCESS_KEY_ID=
# OFFSITE_AWS_SECRET_ACCESS_KEY=
# Google Drive: archivo de rclone con el remoto (chmod 600, fuera del repo).
# OFFSITE_RCLONE_CONFIG=/home/deploy/.config/rclone/rclone.conf
# Check propio de healthchecks.io para la copia externa (distinto al del respaldo nocturno).
# OFFSITE_HEALTHCHECK_URL=

# --- Monitoreo (scripts/watchdog.sh; opcional, guía en docs/08-monitoreo.md) ---
# Latido del watchdog en healthchecks.io (check de 10 min): avisa si el VPS se apaga entero o
# si un aviso no pudo salir por correo.
# MONITOR_HEALTHCHECK_URL=
# Umbrales (estos son los valores por defecto).
# MONITOR_DISK_MIN_GB=5
# MONITOR_BACKUP_MAX_AGE_H=26
# MONITOR_TLS_MIN_DAYS=14
# MONITOR_OFFSITE_MAX_AGE_H=30
