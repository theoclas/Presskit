# Producción (VPS). Copiar a .env con scripts/init-env.sh, que genera los secretos.
# - chmod 600, nunca en git. Guarda una copia en tu gestor de contraseñas.
# - Valores con espacios, $ o comillas van entre comillas SIMPLES ('...'): compose interpreta $.
# - Claves de BD en hex: caben sin escapar en DATABASE_URL.
# - Ninguna variable ADMIN_* salvo ADMIN_NOTIFY_EMAIL: el admin se crea con la CLI interactiva.

# --- Compose ---
COMPOSE_PROJECT_NAME=fersua-booking
COMPOSE_FILE=docker-compose.prod.yml
# Puerto del edge, solo en 127.0.0.1. Debe coincidir con deploy/host-nginx/snippets/fersua-booking-proxy.conf
EDGE_PORT=8090

# --- URLs (en el cambio de dominio basta editar y reiniciar el api) ---
PUBLIC_URL=https://booking.fersuastudio.com
# Orígenes extra además de PUBLIC_URL, separados por coma. Normalmente vacío.
CORS_ORIGINS=
APP_TIMEZONE=America/Bogota

# --- MySQL (init-env.sh: openssl rand -hex 32) ---
DB_NAME=fersua_booking
DB_ROOT_PASSWORD=
# Usuario que migra (MYSQL_USER de la imagen): todos los permisos sobre DB_NAME.
DB_MIGRATOR_USER=fersua_migrator
DB_MIGRATOR_PASSWORD=
# Usuario del api: solo SELECT/INSERT/UPDATE/DELETE (deploy/mysql/init/01-app-user.sh).
DB_APP_USER=fersua_app
DB_APP_PASSWORD=
DB_CONNECTION_LIMIT=5

# --- Secretos de la app (init-env.sh: openssl rand -hex 48; MFA_ENC_KEY: -hex 32) ---
JWT_ACCESS_SECRET=
BOOKING_FORM_SECRET=
IP_HASH_SECRET=
# 32 bytes en hex (64 caracteres). Cifra el secreto TOTP del admin: si se pierde, hay que reconfigurar el 2FA.
MFA_ENC_KEY=

# --- Correo (Hostinger Email, buzón no-reply@fersuastudio.com) ---
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@fersuastudio.com
# La clave del buzón, entre comillas simples.
SMTP_PASS=''
MAIL_FROM='Fersua Studio <no-reply@fersuastudio.com>'
# Recibe los avisos de "nuevo DJ esperando aprobación". Puede quedar vacío.
ADMIN_NOTIFY_EMAIL=

# --- Banderas ---
# true solo después del cambio al dominio principal (robots.txt y meta robots).
SEO_INDEXABLE=false
# true cuando se abra el registro de DJs (M3).
REGISTRATION_OPEN=false
LOG_LEVEL=info

# --- Respaldos (scripts/backup.sh) ---
BACKUP_DIR=/home/deploy/backups/fersua-booking
# Días que se guardan los respaldos nocturnos de la BD (los semanales, 8 semanas).
BACKUP_RETENTION_DAYS=14
# Instantáneas diarias de los medios que se guardan (incrementales con enlaces duros).
BACKUP_MEDIA_KEEP=7
# Opcional: URL de healthchecks.io que se llama al terminar cada respaldo nocturno.
BACKUP_HEALTHCHECK_URL=
