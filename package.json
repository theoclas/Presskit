{
  "name": "fersuastudio-booking",
  "private": true,
  "description": "Plataforma de booking de DJs de Fersua Studio (NestJS + React + MySQL)",
  "workspaces": [
    "packages/shared",
    "api",
    "web"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build:shared": "npm run build -w @fersua/shared",
    "build": "npm run build:shared && npm run build -w api && npm run build -w web",
    "dev:api": "npm run start:dev -w api",
    "dev:web": "npm run dev -w web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "ci:compose": "node scripts/ci/check-compose.mjs",
    "ci:bundle": "node scripts/ci/check-bundle.mjs"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.0"
  }
}
