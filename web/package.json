    "@fersua/shared": "*",
    "@fontsource-variable/inter": "^5.3.0",
    "@tanstack/react-query": "^5.104.0",
    "antd": "^6.6.5",
    "axios": "^1.20.0",
    "dayjs": "^1.11.23",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^7.18.4",
    "simple-icons": "^16.33.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.57.0",
    "@testing-library/dom": "^10.4.2",
